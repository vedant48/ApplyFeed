# ====================================================================
# APPLYFEED ENVIRONMENT CONFIGURATION (APPWRITE)
# ====================================================================

# 1. Appwrite Cloud Configuration
# Get these from: Appwrite Console -> Project Settings -> API Keys / Project ID
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID="[YOUR-APPWRITE-PROJECT-ID]"
APPWRITE_API_KEY="standard_[YOUR-APPWRITE-API-KEY]"
APPWRITE_DATABASE_ID="applyfeed"

# 2. Security: AES-256 Key for Token Encryption at Rest (min 32 characters)
ENCRYPTION_SECRET="applyinbox-secure-secret-key-32b-min!"

# 3. AI Provider (Optional: if omitted, high-precision deterministic classifier runs)
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"

# 4. Email OAuth Credentials (Optional: required for live Gmail & Outlook OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
